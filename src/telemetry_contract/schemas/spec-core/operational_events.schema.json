{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:telemetry:spec-core:0.3.0:operational-events",
  "title": "SPEC-CORE observable operational event row",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "entity_id", "event_type", "event_start", "event_end", "known_at", "attributes_json", "source"],
  "properties": {
    "event_id": {"type": "string"},
    "entity_id": {"type": "string"},
    "event_type": {"type": "string"},
    "event_start": {"type": "string", "format": "date-time"},
    "event_end": {"type": ["string", "null"], "format": "date-time"},
    "known_at": {"type": "string", "format": "date-time"},
    "attributes_json": {"type": "string"},
    "source": {"type": "string"}
  }
}
