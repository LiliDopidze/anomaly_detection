{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:telemetry:spec-core:0.3.0:entity-relations",
  "title": "SPEC-CORE entity relation row",
  "type": "object",
  "additionalProperties": false,
  "required": ["parent_entity_id", "child_entity_id", "relation_type", "relation_family", "valid_from", "valid_to", "relation_confidence", "source"],
  "properties": {
    "parent_entity_id": {"type": "string"},
    "child_entity_id": {"type": "string"},
    "relation_type": {"type": "string"},
    "relation_family": {"type": "string"},
    "valid_from": {"type": ["string", "null"], "format": "date-time"},
    "valid_to": {"type": ["string", "null"], "format": "date-time"},
    "relation_confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "source": {"type": "string"}
  }
}
