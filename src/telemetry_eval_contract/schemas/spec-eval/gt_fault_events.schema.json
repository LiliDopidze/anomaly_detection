{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:telemetry:spec-eval:0.3.0:gt-fault-events",
  "title": "SPEC-EVAL fault event row",
  "type": "object",
  "additionalProperties": false,
  "required": ["fault_event_id", "fault_type", "fault_family", "fault_domain_type", "fault_domain_id", "onset_ts", "first_observable_ts", "impact_ts", "resolution_ts", "cause_group_id", "left_censored", "label_source", "source_instance_id"],
  "properties": {
    "fault_event_id": {"type": "string"},
    "fault_type": {"type": "string"},
    "fault_family": {"type": ["string", "null"]},
    "fault_domain_type": {"type": ["string", "null"]},
    "fault_domain_id": {"type": ["string", "null"]},
    "onset_ts": {"type": ["string", "null"], "format": "date-time"},
    "first_observable_ts": {"type": ["string", "null"], "format": "date-time"},
    "impact_ts": {"type": ["string", "null"], "format": "date-time"},
    "resolution_ts": {"type": ["string", "null"], "format": "date-time"},
    "cause_group_id": {"type": ["string", "null"]},
    "left_censored": {"type": "boolean"},
    "label_source": {"type": "string"},
    "source_instance_id": {"type": ["string", "null"]}
  }
}
